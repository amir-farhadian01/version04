import 'package:flutter/material.dart';
import 'package:provider/provider.dart';
import 'theme/app_theme.dart';
import 'providers/cache_provider.dart';
import 'screens/auth_screen.dart';
import 'screens/home_screen.dart';
import 'screens/social_screen.dart';
import 'screens/activity_screen.dart';
import 'screens/profile_screen.dart';
import 'screens/business_profile_screen.dart';
import 'screens/dashboard_screen.dart';
import 'screens/explorer/explorer_screen.dart';
import 'screens/home/home_screen.dart' as home_new;
import 'screens/customer/dashboard_screen.dart';
import 'screens/customer/orders_screen.dart';
import 'screens/customer/order_detail_screen.dart';
import 'screens/customer/messages_screen.dart';
import 'screens/customer/contract_chat_screen.dart';
import 'screens/customer/new_order_screen.dart';
import 'screens/business/business_page_screen.dart';
import 'screens/profile/upgrade_to_business_screen.dart';
import 'screens/explorer/story_screen.dart';
import 'screens/explorer/comments_screen.dart';
import 'screens/post_detail_screen.dart';
import 'widgets/flutter_app_scaffold.dart';

void main() {
  runApp(
    MultiProvider(
      providers: [
        ChangeNotifierProvider(create: (_) => ThemeProvider()),
        ChangeNotifierProvider(create: (_) => CacheProvider()),
      ],
      child: const NeighborHubApp(),
    ),
  );
}

class NeighborHubApp extends StatelessWidget {
  const NeighborHubApp({super.key});

  @override
  Widget build(BuildContext context) {
    final themeProvider = context.watch<ThemeProvider>();
    return MaterialApp(
      title: 'NeighborHub',
      debugShowCheckedModeBanner: false,
      theme: AppTheme.lightTheme,
      darkTheme: AppTheme.darkTheme,
      themeMode: themeProvider.themeMode,
      initialRoute: '/auth',
      routes: {
        // ── Tab screens (with bottom nav, no back) ──
        '/home': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'home',
              child: HomeScreen(),
            ),
        '/social': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'explorer',
              child: SocialScreen(),
            ),
        '/activity': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'activity',
              child: ActivityScreen(),
            ),
        '/profile': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'activity',
              child: ProfileScreen(),
            ),
        '/explorer': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'explorer',
              child: ExplorerScreen(),
            ),
        '/new-home': (_) => const FlutterAppScaffold(
              showBottomNav: true,
              currentTab: 'home',
              child: home_new.FlutterHomeScreen(),
            ),

        // ── Standalone screens (with header + back button, no bottom nav) ──
        '/auth': (_) => const FlutterAppScaffold(
              title: 'Sign In',
              showBack: true,
              child: AuthScreen(),
            ),
        '/biz-profile': (_) => const FlutterAppScaffold(
              title: 'Business',
              child: BusinessProfileScreen(),
            ),
        '/dashboard': (_) => const FlutterAppScaffold(
              title: 'Dashboard',
              expandOnDesktop: true,
              child: DashboardScreen(),
            ),
        '/services': (_) => const FlutterAppScaffold(
              title: 'Services',
              showBack: true,
              expandOnDesktop: true,
              child: CustomerDashboardScreen(),
            ),
        '/customer/orders': (_) => const FlutterAppScaffold(
              title: 'My Orders',
              showBack: true,
              expandOnDesktop: true,
              child: CustomerOrdersScreen(),
            ),
        '/customer/messages': (_) => const FlutterAppScaffold(
              title: 'Messages',
              showBack: true,
              expandOnDesktop: true,
              child: CustomerMessagesScreen(),
            ),
        '/profile/upgrade': (_) => const FlutterAppScaffold(
              title: 'Upgrade to Business',
              showBack: true,
              child: UpgradeToBusinessScreen(),
            ),
        '/order/new': (_) => const FlutterAppScaffold(
              title: 'New Order',
              showBack: true,
              child: NewOrderScreen(),
            ),
      },
      onGenerateRoute: (settings) {
        if (settings.name == '/customer/order-detail') {
          final orderId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Order Details',
              showBack: true,
              expandOnDesktop: true,
              child: CustomerOrderDetailScreen(orderId: orderId),
            ),
          );
        }
        if (settings.name == '/customer/contract-chat') {
          final chatId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Contract Chat',
              showBack: true,
              expandOnDesktop: true,
              child: CustomerContractChatScreen(chatId: chatId),
            ),
          );
        }
        if (settings.name == '/business') {
          final businessId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Business',
              showBack: true,
              child: BusinessPageScreen(businessId: businessId),
            ),
          );
        }
        if (settings.name == '/explorer/story') {
          final storyId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Story',
              showBack: true,
              child: StoryScreen(storyId: storyId),
            ),
          );
        }
        if (settings.name == '/explorer/comments') {
          final postId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Comments',
              showBack: true,
              child: CommentsScreen(postId: postId),
            ),
          );
        }
        if (settings.name == '/post-detail') {
          final postId = settings.arguments as String? ?? '';
          return MaterialPageRoute(
            builder: (_) => FlutterAppScaffold(
              title: 'Post',
              showBack: true,
              child: PostDetailScreen(postId: postId),
            ),
          );
        }
        if (settings.name == '/order/new') {
          return MaterialPageRoute(
            builder: (_) => const FlutterAppScaffold(
              title: 'New Order',
              showBack: true,
              child: NewOrderScreen(),
            ),
          );
        }
        return null;
      },
    );
  }
}