  mediaAssetId     String?              @unique
  orders           Order[]

  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([moderationStatus])
}

model PostMedia {
  id           String        @id @default(cuid())
  postId       String
  post         Post          @relation(fields: [postId], references: [id])
  type         PostMediaType
  url          String
  thumbnailUrl String?
  duration     Int?          // seconds for video
  width        Int?
  height       Int?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  @@index([postId])
}

model PostLocation {
  id        String   @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  city      String?
  province  String?
  country   String?  @default("CA")
  createdAt DateTime @default(now())
  posts     Post[]
}

model PostComment {
  id               String               @id @default(cuid())
  postId           String
  post             Post                 @relation(fields: [postId], references: [id])
  authorId         String
  author           User                 @relation(fields: [authorId], references: [id])
  parentId         String?
  parent           PostComment?         @relation("CommentReplies", fields: [parentId], references: [id])
  replies          PostComment[]        @relation("CommentReplies")
  text             String
  likeCount        Int                  @default(0)
  replyCount       Int                  @default(0)
  moderationStatus PostModerationStatus @default(pending)
  createdAt        DateTime             @default(now())
  archivedAt       DateTime?
  likes            CommentLike[]
  attachments      CommentAttachment[]

  @@index([postId])
  @@index([parentId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostSave {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

model CommentAttachment {
  id           String   @id @default(cuid())
  commentId    String
  comment      PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url          String
  type         String   // 'image' | 'video' | 'file'
  thumbnailUrl String?
  fileName     String?
  fileSize     Int?     // bytes
  width        Int?
  height       Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([commentId])
}

enum StoryVisibility {
  PUBLIC
  FOLLOWERS_ONLY
}

model Story {
