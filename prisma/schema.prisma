}

model Post {
  id               String               @id @default(cuid())
  authorId         String
  author           User                 @relation(fields: [authorId], references: [id])
  categoryId       String
  category         Category             @relation(fields: [categoryId], references: [id])
  caption          String?
  locationId       String?
  location         PostLocation?        @relation(fields: [locationId], references: [id])
  media            PostMedia[]
  serviceCatalogId String?
  linkedService    ServiceCatalog?      @relation(fields: [serviceCatalogId], references: [id])
  isBusinessPost   Boolean              @default(false)
  isPromoted       Boolean              @default(false)
  likeCount        Int                  @default(0)
  commentCount     Int                  @default(0)
  viewCount        Int                  @default(0)
  saveCount        Int                  @default(0)
  moderationStatus PostModerationStatus @default(pending)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  archivedAt       DateTime?
  comments         PostComment[]
  likes            PostLike[]
  saves            PostSave[]
