generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  platform_admin
  developer
  support
  finance
  customer
  provider
  staff
}

enum StaffRole {
  handyman
  finance
  adv
  career
  task_manager
  internal_manager
  hr
}

enum Status {
  active
  suspended
  pending_verification
}

enum KycStatus {
  draft
  pending
  approved
  rejected
  resubmit_requested
}

enum KycSubmissionType {
  level0
  personal
  business
}

enum OrderStatus {
  draft
  submitted
  cancelled
  matching
  expired
  matched
  contracted
  paid
  in_progress
  completed
  disputed
  closed
}

enum OrderPhase {
  draft
  offer
  order
  job
}

enum OfferStatus {
  pending // broadcast sent, awaiting provider response
  expired // no provider responded in time
  converted // at least one provider accepted -> Order created
  cancelled // customer cancelled before conversion
}

enum JobStatus {
  scheduled // Order contracted + paid, awaiting start
  in_progress // provider checked in
  completed // provider marked done
  disputed // dispute raised after completion
  cancelled // cancelled after job started
}

enum OrderEntryPoint {
  explorer
  ai_suggestion
  direct
  wizard
  reorder
  guest
}

enum BookingMode {
  booking
  direct_booking
  hybrid
  quote_first
  walk_in
  inherit_from_catalog
}

enum PaymentStatus {
  pending
  captured
  releaseScheduled  // escrowReleaseAt has been set, waiting for timer
  refunded
  failed
}

enum OrderUrgency {
  standard
  urgent
  emergency
}

enum SessionStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AttendeeStatus {
  registered
  confirmed
  cancelled
  attended
}

enum SubcontractStatus {
  pending      // prime sent request, awaiting sub
  accepted     // sub accepted
  rejected     // sub rejected
  in_progress  // sub working on job
  completed    // sub marked done
  cancelled    // cancelled before start
}

enum ChatRestrictionLevel {
  none
  warning
  temporary_restricted
  permanent_restricted
}

enum MatchAttemptStatus {
  invited
  matched
  accepted
  declined
  expired
  superseded
}

enum ChatMessageType {
  text
  system
}

enum ChatModerationStatus {
  clean
  masked
  blocked
  flagged
}

enum PostModerationStatus {
  pending
  approved
  rejected
  flagged
}

enum PostMediaType {
  image
  video
}

enum ContractVersionStatus {
  draft
  sent
  approved
  rejected
  superseded
}

enum ContractActionType {
  provider_sent
  customer_approved
  customer_rejected
  customer_requested_edit
  provider_superseded
  admin_override
  admin_marked_reviewed
  admin_internal_note
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                  String      @id @default(cuid())
  email               String      @unique
  normalizedEmail     String?     @unique
  password            String?     // nullable for OAuth users
  phone               String?     @unique
  firstName           String?
  lastName            String?
  displayName         String?
  normalizedDisplayName String?   @unique
  username            String?     @unique
  normalizedUsername  String?     @unique
  role                UserRole    @default(customer)
  staffRole           StaffRole?
  status              Status      @default(active)
  isVerified          Boolean     @default(false)
  isGuest             Boolean     @default(false) @map("is_guest")
  mfaEnabled          Boolean     @default(false)
  creditLimit         Float?      @default(0)
  currentDebt         Float?      @default(0)
  companyId           String?
  gender              String?     // 'male' | 'female' | 'other' — free string, UI validates
  address             String?     // full readable address (keep `location` for coords)
  lastLoginAt         DateTime?
  lastSeenAt          DateTime?
  lastDevice          String?     // user-agent short label e.g. "iPhone 15 / iOS 17 / Safari"
  lastIp              String?
  registrationIp    String?
  birthDate           DateTime?
  bio                 String?
  location            String?
  locationLat         Float?      // latitude for geo queries (cached in Redis)
  locationLng         Float?      // longitude for geo queries (cached in Redis)
  avatarUrl           String?
  /// Google `sub` when the account is linked to Google (OAuth).
  googleId            String?     @unique
  /// Apple `sub` when the account is linked to Apple (Sign in with Apple).
  appleId             String?     @unique
  /// Set to now() when the user completes the onboarding wizard.
  onboardingCompletedAt DateTime?
  /// Category IDs the user selected during onboarding (for feed algorithm).
  onboardingInterests String[]
  /// Client-driven settings: privacy, device whitelist, safety flags (see app JSON contract).
  accountPreferences  Json?
  orderPriorities     Json?
  refreshToken        String?     // for JWT refresh
  /// Incremented on each pre-contract PII violation. Auto-flag for admin review at threshold.
  circumventionScore  Int         @default(0)
  /// Chat restriction level triggered by circumvention score thresholds
  chatRestrictionLevel  ChatRestrictionLevel  @default(none) @map("chat_restriction_level")
  /// When temporary restriction expires (set when score >= 5)
  chatRestrictionExpiresAt DateTime? @map("chat_restriction_expires_at")
  /// Last time circumvention score was decayed by 1 (daily decay)
  circumventionScoreDecayedAt DateTime? @map("circumvention_score_decayed_at")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  ownedCompany        Company?    @relation("CompanyOwner")
  companies           CompanyUser[]
  contractsAsCustomer Contract[]  @relation("CustomerContracts")
  contractsAsProvider Contract[]  @relation("ProviderContracts")
  auditLogs           AuditLog[]
  transactions        Transaction[]
  schedules           Schedule[]
  kyc                 KYC?
  ticketsCreated      Ticket[]    @relation("TicketCreator")
  ticketsReceived     Ticket[]    @relation("TicketRecipient")
  posts               Post[]
  postLikes           PostLike[]
  postSaves           PostSave[]
  postComments        PostComment[]
  commentLikes        CommentLike[]
  notifications       Notification[]
  chatMessages        ChatMessage[]
  requestsAsCustomer  Request[]   @relation("CustomerRequests")
  requestsAsProvider  Request[]   @relation("ProviderRequests")
  services            Service[]
  webauthnCredentials WebAuthnCredential[]
  kycLevel0Profile    KycLevel0Profile?
  kycPersonalSubmissions KycPersonalSubmission[]
  businessKycSubmissions BusinessKycSubmission[]
  ordersAsCustomer       Order[]                 @relation("CustomerOrders")
  customerOrderReviews   OrderReview[]           @relation("CustomerOrderReviews")
  customerDisputes       Dispute[]               @relation("CustomerDisputes")
  providerPackages       ProviderServicePackage[]
  attemptsAsProvider     OfferMatchAttempt[]     @relation("ProviderAttempts")
  ordersAsMatchedProvider Order[]                @relation("OrderMatchedProvider")
  ordersAsAssignedStaff   Order[]                @relation("OrderAssignedStaff")
  addresses              UserAddress[]
  cars                   UserCar[]
  quotesCreated          Quote[]                 @relation("QuoteCreator")
  notesAsCustomer        WorkspaceCustomerNote[] @relation("NoteCustomer")
  notesAsAuthor          WorkspaceCustomerNote[] @relation("NoteAuthor")
  mediaAssets            MediaAsset[]
  invoicesAsCustomer     Invoice[]               @relation("InvoiceCustomer")
  stories                Story[]                 @relation("StoryAuthor")
  storiesViewed          StoryViewer[]
  followers              Follow[]                @relation("Followee")
  following              Follow[]                @relation("Follower")
  packageStaffAssignments PackageStaffAssignment[]
  reviewerReviews       OrderReview[]           @relation("ReviewerUser")
  usernameHistory       UsernameHistory[]
  staffSlotBlocks       StaffSlotBlock[]
  subStaffAssignments   SubcontractorAssignment[] @relation("SubStaff")
}

model UsernameHistory {
  id         String    @id @default(cuid())
  userId     String?
  username   String    @unique
  claimedAt  DateTime  @default(now())
  releasedAt DateTime?
  isActive   Boolean   @default(true)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model WebAuthnCredential {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID        String   @unique
  credentialPublicKey String
  counter             BigInt
  transports          String?  // JSON string
  createdAt           DateTime @default(now())
}

model Company {
  id                  String      @id @default(cuid())
  ownerId             String      @unique
  owner               User        @relation("CompanyOwner", fields: [ownerId], references: [id])
  name                String
  slug                String?     @unique
  slogan              String?
  about               String?
  logoUrl             String?
  coverImageUrl       String?
  licenseNumber       String?
  experienceDate      DateTime?
  address             String?
  phone               String?
  website             String?
  socialLinks         Json?
  type                String      @default("solo") // solo, business
  kycStatus           String      @default("pending") // pending, verified, rejected
  location            Json?
  members             CompanyUser[]
  transactions        Transaction[]
  schedules           Schedule[]
  b2bConnectionsA     B2BConnection[] @relation("ProviderA")
  b2bConnectionsB     B2BConnection[] @relation("ProviderB")
  businessKycSubmissions BusinessKycSubmission[]
  servicePackages         ProviderServicePackage[] @relation("WorkspacePackages")
  products                Product[]                @relation("WorkspaceProducts")
  workspaceAttempts        OfferMatchAttempt[]     @relation("WorkspaceAttempts")
  ordersAsMatchedWorkspace Order[]                @relation("OrderMatchedWorkspace")
  invoices            Invoice[]
  portfolio           BusinessPortfolio?
  businessHoursSchema BusinessHours[]
  quotes              Quote[]
  customerNotes       WorkspaceCustomerNote[]
  primeAssignments    SubcontractorAssignment[] @relation("PrimeContracts")
  subAssignments      SubcontractorAssignment[] @relation("SubContracts")
  staffSlotBlocks     StaffSlotBlock[]
  stripeEnabled       Boolean?    @default(false) @map("stripe_enabled")
  stripeAccountId     String?     @map("stripe_account_id")
  stripeChargesEnabled Boolean?   @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled Boolean?   @default(false) @map("stripe_payouts_enabled")
  paypalEnabled       Boolean?    @default(false) @map("paypal_enabled")
  paypalEmail         String?     @map("paypal_email")
  interacEnabled      Boolean?    @default(false) @map("interac_enabled")
  interacEmail        String?     @map("interac_email")
  squareEnabled       Boolean?    @default(false) @map("square_enabled")
  squareLocationId    String?     @map("square_location_id")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model CompanyUser {
  companyId String
  userId    String
  role      String   @default("member") // 'owner' | 'admin' | 'member' | 'staff' | 'client'
  staffRole String?  @map("staff_role") // 'handyman' | 'technician' | 'specialist' | 'apprentice' | null
  joinedAt  DateTime @default(now())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([companyId, userId])
}

model ServiceCatalog {
  id                    String    @id @default(cuid())
  name                  String
  category              String
  subcategory           String?
  complianceTags        String[]  @default([])
  icon                  String?
  showInHomeClient      Boolean   @default(false)
  categoryId            String?
  category_             Category? @relation(fields: [categoryId], references: [id])
  dynamicFieldsSchema   Json?
  defaultMatchingMode   String    @default("manual_review")
  description           String?
  slug                  String?   @unique
  isActive              Boolean   @default(true)
  /// When set, packages must use this mode or `inherit_from_catalog` (see ADR-0028).
  lockedBookingMode     String?
  sortOrder             Int       @default(0)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  services                Service[]
  orders                  Order[]
  providerPackages        ProviderServicePackage[]
  linkedPosts             Post[]
  formTemplates           ServiceFormTemplate[]

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@index([isActive])
}

model ProviderServicePackage {
  id                String        @id @default(cuid())
  providerId        String
  workspaceId       String
  serviceCatalogId  String
  name              String
  description       String?
  finalPrice        Float
  currency          String        @default("CAD")
  bookingMode       BookingMode   @default(inherit_from_catalog)
  breakTimeMinutes    Int?     @default(15) @map("break_time_minutes")
  durationMinutes     Int?
  maxDailyBookings    Int      @default(10) @map("max_daily_bookings")
  slotDurationMinutes Int      @default(60) @map("slot_duration_minutes")
  isActive          Boolean       @default(true)
  photoRequired     Boolean       @default(true) @map("photo_required")
  archivedAt        DateTime?
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  provider          User          @relation(fields: [providerId], references: [id])
  workspace         Company       @relation("WorkspacePackages", fields: [workspaceId], references: [id])
  serviceCatalog    ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])
  bom               ProductInPackage[]
  offerMatchAttempts OfferMatchAttempt[]
  matchedOrders      Order[]              @relation("OrderMatchedPkg")
  staffAssignments   PackageStaffAssignment[]

  @@index([workspaceId])
  @@index([serviceCatalogId])
  @@unique([workspaceId, serviceCatalogId, name])
}

/// Links a ProviderServicePackage to specific staff members who can perform it.
/// Enables parallel slots when multiple staff offer the same service.
model PackageStaffAssignment {
  id        String   @id @default(cuid())
  packageId String   @map("package_id")
  package   ProviderServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  staffId   String   @map("staff_id")
  staff     User     @relation(fields: [staffId], references: [id])
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([packageId, staffId])
  @@index([staffId])
  @@index([packageId])
  @@map("package_staff_assignments")
}

model OfferMatchAttempt {
  id            String              @id @default(cuid())
  offerId       String
  offer         Order                 @relation("OfferAttempts", fields: [offerId], references: [id], onDelete: Cascade)
  packageId     String
  package       ProviderServicePackage @relation(fields: [packageId], references: [id])
  providerId    String
  provider      User                  @relation("ProviderAttempts", fields: [providerId], references: [id])
  workspaceId   String
  workspace     Company               @relation("WorkspaceAttempts", fields: [workspaceId], references: [id])
  status        MatchAttemptStatus
  score         Float
  distanceKm    Float?
  invitedAt     DateTime              @default(now())
  matchedAt     DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?
  declineReason String?
  supersededAt  DateTime?
  lostReason    String?
  lostFeedback  Json?
  metadata      Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([offerId])
  @@index([workspaceId, status])
  @@index([providerId, status])
}

model Product {
  id            String               @id @default(cuid())
  workspaceId   String
  workspace     Company              @relation("WorkspaceProducts", fields: [workspaceId], references: [id])
  name          String
  sku           String?
  description   String?
  category      String?
  unit          String               @default("each")
  unitPrice     Float
  currency      String               @default("CAD")
  stockQuantity Float?
  isActive      Boolean              @default(true)
  archivedAt    DateTime?
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  bomLines      ProductInPackage[]

  @@index([workspaceId])
  @@unique([workspaceId, sku])
}

model ProductInPackage {
  id                  String                 @id @default(cuid())
  packageId           String
  package             ProviderServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId           String
  product             Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity            Float
  snapshotUnitPrice   Float
  snapshotCurrency    String
  snapshotProductName String
  snapshotUnit        String
  notes               String?
  sortOrder           Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([packageId])
  @@index([productId])
}

model OrderSession {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sessionIndex     Int
  status           SessionStatus @default(scheduled)
  scheduledAt      DateTime?
  actualStartAt    DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  durationMinutes  Int?
  providerNotes    String?
  completionPhotos Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("order_sessions")
}

model Order {
  id                    String          @id @default(cuid())
  customerId            String
  customer              User            @relation("CustomerOrders", fields: [customerId], references: [id])
  serviceCatalogId      String
  serviceCatalog        ServiceCatalog  @relation(fields: [serviceCatalogId], references: [id])
  schemaSnapshot        Json
  answers               Json
  photos                Json
  description           String
  descriptionAiAssisted Boolean         @default(false)
  scheduledAt           DateTime?
  scheduleFlexibility   String
  address               String
  locationLat           Float?
  locationLng           Float?
  entryPoint            OrderEntryPoint @default(direct)
  urgency               OrderUrgency?   @default(standard)
  status                OrderStatus     @default(draft)
  phase                 OrderPhase?
  matchedPackageId      String?
  matchedPackage        ProviderServicePackage? @relation("OrderMatchedPkg", fields: [matchedPackageId], references: [id])
  matchedProviderId     String?
  matchedProvider       User?           @relation("OrderMatchedProvider", fields: [matchedProviderId], references: [id])
  matchedWorkspaceId    String?
  matchedWorkspace      Company?        @relation("OrderMatchedWorkspace", fields: [matchedWorkspaceId], references: [id])
  assignedStaffId       String?         @map("assigned_staff_id")
  assignedStaff         User?           @relation("OrderAssignedStaff", fields: [assignedStaffId], references: [id])
  autoMatchExhausted    Boolean         @default(false)
  matchingExpiresAt     DateTime?
  customerPicks         Json?
  broadcastList         String[]        @default([])
  // Provider IDs invited to this offer (populated by matching engine)
  budget                Int?            @map("budget")    // Customer's budget in cents (set on quote accept)
  budgetMin             Int?            @map("budget_min") // Minimum budget in cents
  budgetMax             Int?            @map("budget_max") // Maximum budget in cents
  cancelReason          String?
  cancelledAt           DateTime?
  submittedAt           DateTime?
  postId                String?         @map("post_id")
  post                  Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  originalOrderId       String?         @map("original_order_id")
  originalOrder         Order?          @relation("OrderReorder", fields: [originalOrderId], references: [id])
  reorders              Order[]         @relation("OrderReorder")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  matchAttempts         OfferMatchAttempt[] @relation("OfferAttempts")
  chatThread            OrderChatThread?
  orderContract         OrderContract?
  customerReview        OrderReview?
  dispute               Dispute?
  jobRecord             JobRecord?      @relation("OrderJob")
  invoice               Invoice?
  quotes                Quote[]
  payment               Payment?        @relation("OrderPayment")
  sessions              OrderSession[]
  groupSessions         GroupServiceSession[]
  isMultiSession        Boolean         @default(false) @map("is_multi_session")
  totalSessions         Int             @default(1) @map("total_sessions")
  completedSessions     Int             @default(0) @map("completed_sessions")
  subcontractorAssignment SubcontractorAssignment? @relation("OrderSubcontract")
  formTemplateVersion   Int?            @map("form_template_version")

  @@index([customerId])
  @@index([status])
  @@index([phase])
  @@index([serviceCatalogId])
  @@index([postId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique @map("order_id")
  order         Order         @relation("OrderPayment", fields: [orderId], references: [id])
  amount        Int                        // Amount in cents (e.g., 5000 = $50.00)
  commission    Int           @default(0)  // Platform fee in cents
  deduction     Int           @default(0)  // Provider payout in cents (amount - commission)
  status        PaymentStatus @default(pending)
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripeTransferId       String? @map("stripe_transfer_id")
  escrowReleaseAt DateTime?   @map("escrow_release_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("payments")
}

model JobRecord {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  order               Order     @relation("OrderJob", fields: [orderId], references: [id], onDelete: Cascade)
  status              JobStatus @default(scheduled)
  scheduledStartAt    DateTime?
  actualStartAt       DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  providerNotes       String?
  completionPhotos    Json?
  // Performance metrics for F9 analytics
  responseTimeMinutes Int?
  priceDelta          Float?    // final price - original quoted price
  customerRating      Int?      // 1-5, copied from OrderReview after close
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderReview {
  id          String   @id @default(cuid())
  orderId     String   @unique
  customerId  String
  rating      Int
  reviewText  String?
  reviewerId  String?
  reviewType  String   @default("customer") // "customer" or "provider"
  createdAt   DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation("CustomerOrderReviews", fields: [customerId], references: [id])
  reviewer User? @relation("ReviewerUser", fields: [reviewerId], references: [id])

  @@index([customerId])
  @@index([reviewerId])
}

model Dispute {
  id         String   @id @default(cuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("CustomerDisputes", fields: [customerId], references: [id])
  reason     String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model OrderChatThread {
  id         String            @id @default(cuid())
  orderId    String            @unique
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  providerId String
  isClosed   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  messages   OrderChatMessage[]

  @@index([customerId])
  @@index([providerId])
}

model OrderChatMessage {
  id               String               @id @default(cuid())
  threadId         String
  thread           OrderChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId         String
  senderRole       String
  type             ChatMessageType      @default(text)
  originalText     String
  displayText      String
  moderationStatus ChatModerationStatus @default(clean)
  moderationReasons Json?
  sourceLang       String?
  targetLang       String?
  translatedText   String?
  createdAt        DateTime             @default(now())
  editedAt         DateTime?
  metadata         Json?

  @@index([threadId, createdAt])
  @@index([moderationStatus, createdAt])
}

model OrderContract {
  id                  String             @id @default(cuid())
  orderId             String             @unique
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  currentVersionId    String?            @unique
  currentVersion      ContractVersion?   @relation("CurrentContractVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  adminLastReviewAt   DateTime?
  adminLastReviewById String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  versions            ContractVersion[] @relation("ContractVersionBelongs")
  events              ContractEvent[]
}

model ContractVersion {
  id                String                  @id @default(cuid())
  contractId        String
  contract          OrderContract           @relation("ContractVersionBelongs", fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber     Int
  status            ContractVersionStatus   @default(draft)
  title             String
  termsMarkdown     String
  policiesMarkdown  String?
  scopeSummary      String?
  startDate         DateTime?
  endDate           DateTime?
  amount            Float?
  currency          String?                 @default("CAD")
  generatedByAi     Boolean                 @default(false)
  generationPrompt  String?
  generationContext Json?
  mismatchWarnings  Json?
  sentById          String?
  sentAt            DateTime?
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  markedCurrentFor  OrderContract?        @relation("CurrentContractVersion")
  events              ContractEvent[]

  @@unique([contractId, versionNumber])
  @@index([contractId, status])
}

model ContractEvent {
  id         String             @id @default(cuid())
  contractId String
  contract   OrderContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId  String?
  version    ContractVersion?   @relation(fields: [versionId], references: [id], onDelete: SetNull)
  actorId    String
  actorRole  String
  actionType ContractActionType
  note       String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([contractId, createdAt])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  parentId         String?
