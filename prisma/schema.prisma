  updatedAt        DateTime @updatedAt
}

// ─── Home Intelligence Models ──────────────────────────────────────────────

model HomeContentConfig {
  id              String   @id @default(cuid())
  section         String   @unique // "news", "weather", "police_alerts", "events", "market_data"
  enabled         Boolean  @default(true)
  displayOrder    Int      @default(0) @map("display_order")
  title           String?
  apiEndpoint     String?  @map("api_endpoint") // External API URL
  apiKey          String?  @map("api_key")
  refreshInterval Int      @default(3600) @map("refresh_interval") // seconds
  maxItems        Int      @default(5) @map("max_items")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("home_content_configs")
}

model ServiceRateByLocation {
  id            String   @id @default(cuid())
  city          String
  neighborhood  String?
  categoryId    String?  @map("category_id")
  serviceName   String   @map("service_name")
  avgPrice      Decimal  @map("avg_price")
  minPrice      Decimal  @map("min_price")
  maxPrice      Decimal  @map("max_price")
  sampleSize    Int      @map("sample_size") // Number of data points
  computedAt    DateTime @default(now()) @map("computed_at")

  @@index([city, neighborhood])
  @@map("service_rates_by_location")
}

model DemandAnalytics {
  id            String   @id @default(cuid())
  city          String
  neighborhood  String?
  categoryId    String?  @map("category_id")
  searchCount   Int      @default(0) @map("search_count")
  orderCount    Int      @default(0) @map("order_count")
  uniqueClients Int      @default(0) @map("unique_clients")
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  computedAt    DateTime @default(now()) @map("computed_at")

  @@index([city, neighborhood, periodStart])
  @@map("demand_analytics")
}

// ─── Subcontractor Assignment (ADR-0069) ──────────────────────────────────────

/// When a prime contractor (matched workspace) delegates a Job to an approved subcontractor.
/// Requires an approved B2BConnection between the two workspaces.
model SubcontractorAssignment {
  id                String            @id @default(cuid())
  orderId           String            @unique
  order             Order             @relation("OrderSubcontract", fields: [orderId], references: [id], onDelete: Cascade)
  primeWorkspaceId  String            @map("prime_workspace_id")
  primeWorkspace    Company           @relation("PrimeContracts", fields: [primeWorkspaceId], references: [id])
  subWorkspaceId    String            @map("sub_workspace_id")
  subWorkspace      Company           @relation("SubContracts", fields: [subWorkspaceId], references: [id])
  assignedStaffId   String?           @map("assigned_staff_id")
  assignedStaff     User?             @relation("SubStaff", fields: [assignedStaffId], references: [id])
  status            SubcontractStatus @default(pending)
  /// Prime contractor's revenue share percentage (e.g., 70 = 70%)
  primeSharePercent Float             @default(100) @map("prime_share_percent")
  /// Subcontractor's revenue share percentage (e.g., 30 = 30%)
  subSharePercent   Float             @default(0) @map("sub_share_percent")
  notes             String?
  agreedAt          DateTime?         @map("agreed_at")
  startedAt         DateTime?         @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  rejectedAt        DateTime?         @map("rejected_at")
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([primeWorkspaceId, status])
  @@index([subWorkspaceId, status])
  @@map("subcontractor_assignments")
}

// ─── Staff Slot Blocking (ADR-0070) ────────────────────────────────────────────

/// Blocks a staff member's time in ALL their workspaces when assigned to a job.
/// Prevents double-booking across multiple businesses.
model StaffSlotBlock {
  id          String   @id @default(cuid())
  staffId     String   @map("staff_id")
  staff       User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workspaceId String   @map("workspace_id")
  workspace   Company  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  /// "order:<orderId>" or "manual" or "leave" or "break"
  reason      String?
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([staffId, startAt, endAt])
  @@index([workspaceId, startAt])
  @@index([orderId])
  @@map("staff_slot_blocks")
}

// ─── AI Dynamic Form Templates (ADR-0071) ──────────────────────────────────────

/// Versioned form schema for a ServiceCatalog item.
/// Can be generated by AI or created manually by admin.
/// The schema follows the platform's DynamicFieldSpec format (same as ServiceCatalog.dynamicFieldsSchema).
model ServiceFormTemplate {
  id               String         @id @default(cuid())
  serviceCatalogId String         @map("service_catalog_id")
  serviceCatalog   ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Cascade)
  version          Int            @default(1)
  isActive         Boolean        @default(false) @map("is_active")
  /// JSON Schema with UI hints — array of DynamicFieldSpec objects
  schema           Json
  /// Whether this schema was generated by AI
  generatedByAi    Boolean        @default(false) @map("generated_by_ai")
  /// The prompt used for AI generation (preserved for audit)
  aiPrompt         String?        @map("ai_prompt")
  /// AI model used (e.g. "gemini-2.0-flash")
  aiModel          String?        @map("ai_model")
  publishedById    String?        @map("published_by_id")
  publishedAt      DateTime?      @map("published_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([serviceCatalogId, version])
  @@index([serviceCatalogId, isActive])
  @@map("service_form_templates")
}

// ─── Group Service Sessions (G7) ────────────────────────────────────────────

model GroupServiceSession {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxAttendees Int     @default(10) @map("max_attendees")
  scheduledAt DateTime
  durationMinutes Int  @map("duration_minutes")
  locationId  String?
  pricePerAttendee Int @map("price_per_attendee") // cents
  createdAt   DateTime @default(now())
  archivedAt  DateTime?
  attendees   GroupSessionAttendee[]

  @@index([orderId])
  @@map("group_service_sessions")
}

model GroupSessionAttendee {
  id          String         @id @default(cuid())
  sessionId   String
  session     GroupServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  status      AttendeeStatus @default(registered)
  paidAt      DateTime?
  createdAt   DateTime       @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@map("group_session_attendees")
}
