# Neighborly port registry (numeric values only; no credentials).
# Format: ENVIRONMENT | SERVICE | PORT | STATUS | EXECUTABLE SOURCE | NOTE
# Status values: host-runtime, compose-published, container-internal,
# documentation-test-only, or reserved-non-usable.
#
# Do not source this file in an application process. run-project.sh parses only
# the approved numeric keys below. Compose commands must pass this file with
# `--env-file config/ports.env`; it supplies Compose port interpolation.

# local-development | Node API | 8080 | host-runtime | server.ts PORT
LOCAL_DEVELOPMENT_API_HOST_PORT=8080
# local-development | Node admin server / built admin SPA | 9090 | host-runtime | server.ts ADMIN_PORT
LOCAL_DEVELOPMENT_ADMIN_HOST_PORT=9090
# local-development | customer Vite | 5173 | host-runtime | frontend/vite.config.ts
LOCAL_DEVELOPMENT_VITE_HOST_PORT=5173
# local-development | admin Vite | 9091 | host-runtime | frontend/admin/vite.config.ts
LOCAL_DEVELOPMENT_ADMIN_VITE_HOST_PORT=9091
# local-development | Flutter web conventional path | 7357 | documentation-test-only | docs, E2E, scripts
LOCAL_DEVELOPMENT_FLUTTER_DOCUMENTED_HOST_PORT=7357
# IDE-task | Flutter web listener | 9088 | host-runtime | .vscode/tasks.json and launch.json
IDE_FLUTTER_WEB_HOST_PORT=9088
# IDE-task | Flutter API target | 8077 | reserved-non-usable | .vscode/tasks.json; CLAUDE.md marks legacy
IDE_FLUTTER_API_TARGET_PORT=8077

# base-compose | Traefik HTTP | 80 | compose-published | docker-compose.yml
BASE_COMPOSE_TRAEFIK_HTTP_HOST_PORT=80
# base-compose | Traefik dashboard | 9191 | compose-published | docker-compose.yml
BASE_COMPOSE_TRAEFIK_DASHBOARD_HOST_PORT=9191
# base-compose | Traefik HTTP / dashboard targets | 80 / 8080 | container-internal | docker-compose.yml
BASE_COMPOSE_TRAEFIK_HTTP_CONTAINER_PORT=80
BASE_COMPOSE_TRAEFIK_DASHBOARD_CONTAINER_PORT=8080
# base-compose | PostgreSQL default host publish | 5432 | compose-published | POSTGRES_HOST_PORT default in docker-compose.yml
BASE_COMPOSE_POSTGRES_HOST_PORT_DEFAULT=5432
# base-compose | PostgreSQL target | 5432 | container-internal | docker-compose.yml
BASE_COMPOSE_POSTGRES_CONTAINER_PORT=5432
# base-compose | PostgreSQL media | 5433 | compose-published | docker-compose.yml
BASE_COMPOSE_POSTGRES_MEDIA_HOST_PORT=5433
# base-compose | PostgreSQL media target | 5432 | container-internal | docker-compose.yml
BASE_COMPOSE_POSTGRES_MEDIA_CONTAINER_PORT=5432
# base-compose | Redis | 6379 | compose-published | docker-compose.yml
BASE_COMPOSE_REDIS_HOST_PORT=6379
# base-compose | Redis target | 6379 | container-internal | docker-compose.yml
BASE_COMPOSE_REDIS_CONTAINER_PORT=6379
# base-compose | MinIO API / console | 9002 / 9003 | compose-published | docker-compose.yml
BASE_COMPOSE_MINIO_API_HOST_PORT=9002
BASE_COMPOSE_MINIO_CONSOLE_HOST_PORT=9003
# base-compose | MinIO API / console targets | 9000 / 9001 | container-internal | docker-compose.yml
BASE_COMPOSE_MINIO_API_CONTAINER_PORT=9000
BASE_COMPOSE_MINIO_CONSOLE_CONTAINER_PORT=9001
# base-compose | Portainer / Dozzle / Metabase | compose-published | docker-compose.yml
BASE_COMPOSE_PORTAINER_HOST_PORT=9000
BASE_COMPOSE_DOZZLE_HOST_PORT=8899
BASE_COMPOSE_METABASE_HOST_PORT=3001
# base-compose | Portainer / Dozzle / Metabase targets | container-internal | docker-compose.yml
BASE_COMPOSE_PORTAINER_CONTAINER_PORT=9000
BASE_COMPOSE_DOZZLE_CONTAINER_PORT=8080
BASE_COMPOSE_METABASE_CONTAINER_PORT=3000
# base-compose | NATS / API / admin / frontend / Grafana | container-internal | docker-compose.yml
BASE_COMPOSE_NATS_CONTAINER_PORT=4222
BASE_COMPOSE_API_CONTAINER_PORT=8080
BASE_COMPOSE_ADMIN_CONTAINER_PORT=9090
BASE_COMPOSE_FRONTEND_CONTAINER_PORT=5173
BASE_COMPOSE_GRAFANA_CONTAINER_PORT=3000
# base-compose | Loki | 3100 | container-internal | docker-compose.yml
BASE_COMPOSE_LOKI_CONTAINER_PORT=3100
# base-compose | Docker API 8888, admin 9090 and frontend 5173 mappings | documentation-test-only | commented in docker-compose.yml
BASE_COMPOSE_DOCUMENTED_API_HOST_PORT=8888
BASE_COMPOSE_DOCUMENTED_ADMIN_HOST_PORT=9090
BASE_COMPOSE_DOCUMENTED_FRONTEND_HOST_PORT=5173

# staging-compose | PostgreSQL / media / Redis / NATS | compose-published | docker-compose.staging.yml
STAGING_POSTGRES_HOST_PORT=55432
STAGING_POSTGRES_MEDIA_HOST_PORT=55433
STAGING_REDIS_HOST_PORT=56379
STAGING_NATS_HOST_PORT=54222
# staging-compose | MinIO API / console | compose-published | docker-compose.staging.yml
STAGING_MINIO_API_HOST_PORT=59002
STAGING_MINIO_CONSOLE_HOST_PORT=59003
# staging-compose | API / admin / frontend | compose-published | docker-compose.staging.yml
STAGING_API_HOST_PORT=18080
STAGING_ADMIN_HOST_PORT=19090
STAGING_FRONTEND_HOST_PORT=15173
# staging-compose | Traefik HTTP / dashboard | compose-published | docker-compose.staging.yml
STAGING_TRAEFIK_HTTP_HOST_PORT=18000
STAGING_TRAEFIK_DASHBOARD_HOST_PORT=19191
# staging-compose | Grafana / Dozzle / Metabase / Portainer | compose-published | docker-compose.staging.yml
STAGING_GRAFANA_HOST_PORT=13000
STAGING_DOZZLE_HOST_PORT=18899
STAGING_METABASE_HOST_PORT=13001
STAGING_PORTAINER_HOST_PORT=19000

# development-compose | disposable development PostgreSQL / media / Redis | compose-published | docker-compose.development.yml
DEVELOPMENT_POSTGRES_HOST_PORT=55450
DEVELOPMENT_POSTGRES_MEDIA_HOST_PORT=55451
DEVELOPMENT_REDIS_HOST_PORT=56380

# isolated-verification | RUN-001 disposable PostgreSQL | 55440 | documentation-test-only | historical review record; ownership must be proven before use
ISOLATED_RUN001_POSTGRES_HOST_PORT=55440
# isolated-verification | cycle fixtures | documentation-test-only | historical records only; no listener or reservation is implied
ISOLATED_CYCLE2_POSTGRES_HOST_PORT=55442
ISOLATED_CYCLE5_REJECTED_POSTGRES_HOST_PORT=55443
ISOLATED_CYCLE5_POSTGRES_HOST_PORT=55445
ISOLATED_CYCLE5_DURABLE_POSTGRES_HOST_PORT=55446
ISOLATED_CYCLE6_POSTGRES_HOST_PORT=55447
ISOLATED_CYCLE7_POSTGRES_HOST_PORT=55448
# owner-reserved | PostgreSQL | reserved-non-usable | current owner instruction; no repository launcher may touch these ports
OWNER_RESERVED_POSTGRES_HOST_PORT_55444=55444
OWNER_RESERVED_POSTGRES_HOST_PORT_55449=55449
